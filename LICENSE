Reproduced from fuchsia milestone-1011 branch, which had the above LICENSE at root.

# Code acquisition
## Step 1
```shell
set -e
if [ ! -d topaz ]; then
  git clone --depth 1 https://fuchsia.googlesource.com/topaz topaz
fi
cd topaz
printf '\nHEAD: '; git rev-parse --short HEAD
printf 'BRANCH: '; git branch --show-current || true
printf '\nTop-level shell dirs:\n'
find shell -maxdepth 2 -type d | sort | sed -n '1,120p'
```
## Step 2
```shell
git ls-remote --heads https://fuchsia.googlesource.com/topaz | sed -n '1,120p'
```
## Step 3
```shell
set -e
if [ ! -d ../topaz-m1011 ]; then
  git worktree add ../topaz-m1011 milestone-1011 || {
    git fetch origin milestone-1011:milestone-1011
    git worktree add ../topaz-m1011 milestone-1011
  }
fi
```